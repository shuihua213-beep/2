+// --- RK4 Integration ---
+const rk4Step = (
+  state: { x: number, y: number, vx: number, vy: number },
+  getAcc: (s: { x: number, y: number, vx: number, vy: number }) => { ax: number, ay: number },
+  dt: number
+) => {
+  const evaluate = (initial: any, t: number, dt: number, derivative: any) => {
+    const s = {
+      x: initial.x + derivative.dx * dt,
+      y: initial.y + derivative.dy * dt,
+      vx: initial.vx + derivative.dvx * dt,
+      vy: initial.vy + derivative.dvy * dt,
+    };
+    const acc = getAcc(s);
+    return { dx: s.vx, dy: s.vy, dvx: acc.ax, dvy: acc.ay };
+  };
+
+  const a = evaluate(state, 0, 0, { dx: 0, dy: 0, dvx: 0, dvy: 0 });
+  const b = evaluate(state, dt * 0.5, dt * 0.5, a);
+  const c = evaluate(state, dt * 0.5, dt * 0.5, b);
+  const d = evaluate(state, dt, dt, c);
+
+  const dxdt = 1.0 / 6.0 * (a.dx + 2.0 * (b.dx + c.dx) + d.dx);
+  const dydt = 1.0 / 6.0 * (a.dy + 2.0 * (b.dy + c.dy) + d.dy);
+  const dvxdt = 1.0 / 6.0 * (a.dvx + 2.0 * (b.dvx + c.dvx) + d.dvx);
+  const dvydt = 1.0 / 6.0 * (a.dvy + 2.0 * (b.dvy + c.dvy) + d.dvy);
+
+  return {
+    x: state.x + dxdt * dt,
+    y: state.y + dydt * dt,
+    vx: state.vx + dvxdt * dt,
+    vy: state.vy + dvydt * dt,
+  };
+};
+
+// --- CCD Collision Detection ---
+function checkCollisionCCD(
+  b0: {x: number, y: number}, b1: {x: number, y: number},
+  e0: {x: number, y: number}, e1: {x: number, y: number}
+): boolean {
+  const rx0 = b0.x - e0.x;
+  const ry0 = b0.y - (e0.y - 20);
+  const rx1 = b1.x - e1.x;
+  const ry1 = b1.y - (e1.y - 20);
+
+  if (Math.abs(rx0) < 40 && Math.abs(ry0) < 40) return true;
+  if (Math.abs(rx1) < 40 && Math.abs(ry1) < 40) return true;
+
+  const minX = -40, maxX = 40, minY = -40, maxY = 40;
+  
+  if ((rx0 < minX && rx1 < minX) || (rx0 > maxX && rx1 > maxX) ||
+      (ry0 < minY && ry1 < minY) || (ry0 > maxY && ry1 > maxY)) {
+    return false;
+  }
+
+  const dx = rx1 - rx0;
+  const dy = ry1 - ry0;
+  
+  if (dx !== 0) {
+    const t1 = (minX - rx0) / dx;
+    if (t1 >= 0 && t1 <= 1) {
+      const y = ry0 + t1 * dy;
+      if (y >= minY && y <= maxY) return true;
+    }
+    const t2 = (maxX - rx0) / dx;
+    if (t2 >= 0 && t2 <= 1) {
+      const y = ry0 + t2 * dy;
+      if (y >= minY && y <= maxY) return true;
+    }
+  }
+  
+  if (dy !== 0) {
+    const t3 = (minY - ry0) / dy;
+    if (t3 >= 0 && t3 <= 1) {
+      const x = rx0 + t3 * dx;
+      if (x >= minX && x <= maxX) return true;
+    }
+    const t4 = (maxY - ry0) / dy;
+    if (t4 >= 0 && t4 <= 1) {
+      const x = rx0 + t4 * dx;
+      if (x >= minX && x <= maxX) return true;
+    }
+  }
+
+  return false;
+}
